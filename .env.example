# Copier dans .env.local (ce fichier est ignoré par Git).
# Le script d'installation récupère lui-même les clés du projet.
SUPABASE_URL=https://VOTRE_REFERENCE.supabase.co
# Jeton personnel limité au projet : Database Read/Write, API Keys Read, API Key Secrets Read.
SUPABASE_ACCESS_TOKEN=sbp_fc_...
ADMIN_EMAIL=vous@exemple.fr
# URL autorisée dans Authentication > URL Configuration avant l'invitation.
SITE_URL=http://127.0.0.1:5080/
